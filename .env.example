# mm_v2 — Polymarket-native market maker.
#
# Nothing here is needed for WS-A / WS-B / WS-C (M0.5 read-only). These are the
# M0 / M2.5 live (GATED) credentials described in mm_v2/PLAN.md §12.
# Copy to `.env` and fill in. Do NOT commit real values.

# --- Signer / wallet ---
POLY_PRIVATE_KEY=            # owner/signer key — dedicated low-value wallet; NEVER commit / paste in chat
POLY_FUNDER_ADDRESS=        # collateral holder: deposit wallet (type 3) / proxy / Safe / EOA
POLY_SIGNATURE_TYPE=        # 0 EOA / 1 email-proxy / 2 browser-wallet-proxy / 3 POLY_1271 deposit-wallet (new API users)

# --- CLOB L2 API creds (derive via create_or_derive_api_key in M0) ---
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_HOST=https://clob.polymarket.com

# --- Relayer (gasless CTF) — only if CTF goes via relayer (see PLAN §11 protocol-stack decision) ---
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
RELAYER_HOST=https://relayer-v2.polymarket.com

# Funding: small pUSD on Polygon (CLOB V2 replaced USDC.e). Gas: none if relayer
# (gasless); POL/MATIC only for direct on-chain split/merge/redeem. Enable trading
# allowances. Migrate off the v1 py-clob-client to the §11-chosen v2 stack before M0.
